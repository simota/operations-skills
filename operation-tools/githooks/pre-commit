#!/bin/sh
# Budgets enforced by a mechanism rather than by remembering.
# Install with: make hooks
#
# The checks run against what is being committed — the index — not the working
# tree. Checking the tree passed a commit whose staged content failed, whenever
# the tree had been fixed and the fix not staged.
set -e
top="$(git rev-parse --show-toplevel)"
snap="$(mktemp -d "${TMPDIR:-/tmp}/operation-precommit.XXXXXX")"
trap 'rm -rf "$snap"' EXIT INT TERM
git -C "$top" checkout-index --all --prefix="$snap/"
# Run from a hooks directory another repository shares (a link `make hooks` once
# placed in a global core.hooksPath), this is not that repository's check. Asked
# of HEAD as well as the index: a commit that deletes the registry here is the
# one most in need of checking, and must not read as another repository's.
if [ ! -f "$snap/operation-registry/harness.yaml" ] &&
   ! git -C "$top" cat-file -e HEAD:operation-registry/harness.yaml 2>/dev/null; then
  echo "operation pre-commit: $top is not operations-skills; nothing checked" >&2
  exit 0
fi
OPERATION_PRECOMMIT=1 python3 "$snap/operation-tools/validate.py"
python3 "$snap/operation-tools/figures_check.py"
